export CLICOLOR=1
export LSCOLORS=gxBxhxDxfxhxhxhxhxcxcx

export EDITOR='vim'

export HISTCONTROL=ignoreboth
export HISTIGNORE='# *'

export HOMEBREW_NO_ENV_HINTS=1

# uv-managed interpreter; this shim path is stable across `uv python upgrade`.
export CLOUDSDK_PYTHON="$HOME/.local/bin/python3.14"
export USE_GKE_GCLOUD_AUTH_PLUGIN=True

export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config.rc"

export INSTALLER_NO_MODIFY_PATH=1

export GH_NO_UPDATE_NOTIFIER="1"

export DISABLE_TELEMETRY="1"

# Stops Terraform's "out of date" nag in repos pinned to an older version
export CHECKPOINT_DISABLE="1"
