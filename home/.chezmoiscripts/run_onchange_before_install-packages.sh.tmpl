{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

# Reruns on `chezmoi apply` whenever this script or the Brewfile changes
# Brewfile hash: {{ include "../Brewfile" | sha256sum }}

set -euo pipefail

# Standalone installers (uv, Claude Code, Codex) target ~/.local/bin, which
# dot_path already adds. Having it on PATH here also stops them editing profiles.
PATH="$HOME/.local/bin:$PATH"

# Install Homebrew
if ! command -v brew >/dev/null; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    # Only affects this script's environment, not the shell profile
    for brew_prefix in /opt/homebrew /usr/local; do
        if [ -x "$brew_prefix/bin/brew" ]; then
            eval "$("$brew_prefix/bin/brew" shellenv)"
            break
        fi
    done
fi

# Install uv (explicitly opting out of its profile edits)
if ! command -v uv >/dev/null; then
    curl -LsSf https://astral.sh/uv/install.sh | env UV_NO_MODIFY_PATH=1 sh
fi

# Claude Code and Codex use their own installers, which support self-update
if ! command -v claude >/dev/null; then
    curl -fsSL https://claude.ai/install.sh | bash
fi
if ! command -v codex >/dev/null; then
    curl -fsSL https://chatgpt.com/codex/install.sh | sh
fi

uv python install 3.14

brew bundle --file="{{ .chezmoi.workingTree }}/Brewfile"
{{ end -}}
